# Copy into the repo-root .env (never commit .env). All optional.

# Person 2's endpoint. Empty -> agents use fallback-data/products.json, then agents/mock_products.json
PRODUCT_SEARCH_URL=http://localhost:8000/products/search
PRODUCT_SEARCH_TIMEOUT=25

# LLM for intent parsing. If neither key is set, the rule-based parser is used.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# optional model override, e.g. gpt-4o-mini
LLM_MODEL=

# Fetch.ai bureau REST port (FastAPI calls http://localhost:8001/plan)
AGENTS_PORT=8001
AGENT_SEED_PREFIX=
MAX_REPLAN_ATTEMPTS=3
AGENT_CALL_TIMEOUT=60
