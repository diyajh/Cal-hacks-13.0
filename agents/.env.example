# Local secrets/config for Cal-hacks-13.0. NEVER commit this file (it is in .gitignore).

# --- Fetch.ai / Agentverse ---
# Agentverse API key: used at startup to auto-connect each agent's mailbox (with AGENTVERSE_MAILBOX=true)
AGENTVERSE_API_KEY=
# true = connect agents to Agentverse via mailbox (needs Python 3.10+ / new uagents)
AGENTVERSE_MAILBOX=false
# Make this a long random secret BEFORE connecting to Agentverse (it determines your agent addresses)
AGENT_SEED_PREFIX=

# --- LLM for request parsing (fill one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=

# --- Person 2's product search (live Apify via their FastAPI) ---
PRODUCT_SEARCH_URL=http://localhost:8000/products/search
# seconds to wait for one live search (Apify can be slow)
PRODUCT_SEARCH_TIMEOUT=120
# identical live searches are cached on disk this long (saves Apify cost); clear: python3 -m agents.check cache-clear
SEARCH_CACHE_HOURS=24
# only if you WANT mock products when the live service is down (default: off when PRODUCT_SEARCH_URL is set)
USE_MOCK_FALLBACK=false
# replanning: when_needed (reuse already-retrieved products first; cheapest) | always (fresh search every swap; best demo)
REPLAN_SEARCH=when_needed
AGENTS_PORT=8001
