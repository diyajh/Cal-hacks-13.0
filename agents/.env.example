# Local secrets/config for Cal-hacks-13.0. NEVER commit this file (it is in .gitignore).

# --- Fetch.ai / Agentverse ---
# Agentverse API key: used at startup to auto-connect each agent's mailbox (with AGENTVERSE_MAILBOX=true)
AGENTVERSE_API_KEY=
# true = connect agents to Agentverse via mailbox (needs Python 3.10+ / new uagents)
AGENTVERSE_MAILBOX=false
# Make this a long random secret BEFORE connecting to Agentverse (it determines your agent addresses)
AGENT_SEED_PREFIX=

# --- LLM for request parsing (fill one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=

# --- Person 2's product search (leave empty until their FastAPI is running) ---
PRODUCT_SEARCH_URL=
AGENTS_PORT=8001
