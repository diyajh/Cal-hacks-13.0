{
  "manifest_version": 3,
  "name": "Aura — personal shopping agent",
  "version": "0.1.0",
  "description": "Plan constrained shopping looks with Fetch.ai agents and Cartesia voice.",
  "action": { "default_title": "Open Aura" },
  "side_panel": { "default_path": "index.html" },
  "permissions": ["sidePanel", "scripting", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
